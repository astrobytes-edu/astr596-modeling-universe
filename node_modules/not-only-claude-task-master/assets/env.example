# Required: Your OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use via OpenRouter (Required)
# Find models at https://openrouter.ai/models
# Example: "openai/gpt-4o", "anthropic/claude-3.5-sonnet", "google/gemini-pro-1.5"
MODEL="anthropic/claude-3.5-sonnet"

# Optional: Your Perplexity API Key for research features (https://docs.perplexity.ai/docs/getting-started)
PERPLEXITY_API_KEY=your_perplexity_api_key_here       # Used for --research flag (Optional)
PERPLEXITY_MODEL=sonar-medium-online                # Recommended model: sonar-medium-online (Optional)

# Optional: Configuration settings
MAX_TOKENS=4000                                     # Max tokens for AI response (Optional)
TEMPERATURE=0.7                                     # AI creativity (0-1) (Optional)
DEBUG=false                                         # Enable debug logging (Optional)
LOG_LEVEL=info                                      # Log level (debug, info, warn, error) (Optional)
DEFAULT_SUBTASKS=3                                  # Default subtasks for 'expand' (Optional)
DEFAULT_PRIORITY=medium                             # Default priority for new tasks (Optional)

# Optional: Project Metadata (used in generated files)
# PROJECT_NAME="My Project"                         # Override project name (Optional)
# PROJECT_VERSION="0.1.0"                         # Override project version (Optional)
# AUTHOR="Your Name"                              # Override author name (Optional)